[Unit]
Description=MaskaraPay PII redaction API (development)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=maskara
Group=maskara
WorkingDirectory=/opt/maskarapay
Environment=MASKARA_BIND_ADDR=127.0.0.1:8080
Environment=MASKARA_ASSETS_DIR=/opt/maskarapay/assets
Environment=MASKARA_EXPORT_DIR=/opt/maskarapay/export
Environment=MASKARA_EXPORT_PYTHON=3.12
Environment=MASKARA_ENSURE_MODEL=/opt/maskarapay/bin/ensure-model
Environment=RUST_LOG=service=info
ExecStart=/opt/maskarapay/bin/maskara-service
Restart=on-failure
RestartSec=5
TimeoutStartSec=3600
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

# MaskaraPay x402 payment gating (uncomment to sell paid redactions):
# Environment=MASKARA_PAYEE_ADDRESS=0x...
# Environment=MASKARA_PRICE_USD=0.01
# Environment=MASKARA_X402_NETWORK=base
# Environment=MASKARA_FACILITATOR_URL=https://x402.org/facilitator

[Install]
WantedBy=multi-user.target
