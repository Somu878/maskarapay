[Unit]
Description=MaskaraPay PII redaction API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=maskara
Group=maskara
WorkingDirectory=/opt/maskarapay
Environment=MASKARA_BIND_ADDR=127.0.0.1:8080
Environment=MASKARA_ASSETS_DIR=/opt/maskarapay/assets
Environment=MASKARA_EXPORT_DIR=/opt/maskarapay/export
Environment=MASKARA_ENSURE_MODEL=/opt/maskarapay/bin/ensure-model
Environment=RUST_LOG=service=info
ExecStart=/opt/maskarapay/bin/maskara-service
Restart=on-failure
RestartSec=5
TimeoutStartSec=3600
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
